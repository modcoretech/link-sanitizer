{
  "manifest_version": 3,
  "name": "Link Sanitizer",
  "version": "3.2",
  "description": "Remove tracking parameters from URLs automatically — with batch processing, smart link interception, and a full history page.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Link Sanitizer"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "core/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["core/content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": [
    "clipboardWrite",
    "clipboardRead",
    "storage",
    "contextMenus",
    "tabs",
    "scripting"
  ],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+L", "mac": "Command+Shift+L" },
      "description": "Open Link Sanitizer"
    }
  }
}
