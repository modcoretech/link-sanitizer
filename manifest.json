{
  "manifest_version": 3,
  "name": "Link Sanitizer",
  "version": "3.0.0",
  "description": "Advanced URL cleaning with automatic tracking removal, batch processing, history, and intelligent link interception.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Link Sanitizer"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "core/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["core/content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": [
    "clipboardWrite",
    "clipboardRead",
    "storage",
    "contextMenus",
    "tabs",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Open Link Sanitizer"
    },
    "quick_sanitize": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Quick sanitize clipboard"
    }
  }
}
